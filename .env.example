# PostgreSQL settings for local Docker Compose
POSTGRES_DB=brewlite
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

# API settings (use a long random JWT secret outside local demos)
DATABASE_URL=postgresql://brewlite:change-me-local@localhost:5432/brewlite?schema=public
JWT_SECRET=replace-with-local-random-secret-at-least-32-characters
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_CONTROL=false

# Browser-visible API base URL; must end with the Nest global prefix /api/v1 (ADR 0005)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
