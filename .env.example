# BrewLite - environment template (S-03)
# Copy this file to .env at the repository root and replace the placeholders.
# Never commit .env. Placeholders only: no real secrets or real bank details here.
# Variables are described in docs/deployment.md and docs/architecture/architecture.md (section 9.4).

# --- Database (PostgreSQL) ---
POSTGRES_DB=brewlite
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=change-me-local
# Host port for the Compose database (container port is always 5432).
POSTGRES_PORT=5432
# Used by Prisma when you run commands on your machine (apps/api, outside Docker).
# Docker Compose builds its own URL for the api container with host "db" from the
# POSTGRES_* values above, so you do not need to change this for Compose.
# URL-encode the password if it contains reserved characters.
DATABASE_URL=postgresql://brewlite:change-me-local@localhost:5432/brewlite

# --- Backend (NestJS, apps/api) ---
API_PORT=3001
JWT_SECRET=replace-with-local-random-secret
# Exact frontend origin allowed by CORS (scheme, host, port)
CORS_ORIGIN=http://localhost:3000

# --- Frontend (Next.js, apps/web) ---
# URL the browser uses to reach the API (not the Compose service name).
# Next.js inlines NEXT_PUBLIC_* at build time: rebuild the web image after changing it.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Seed data (apps/api/prisma/seed.ts) ---
# Password for the 10 seeded demo users customer01..customer10@brewlite.test
# SEED_USER_PASSWORD=Brewlite@123

# --- Payment (ADR 005, docs/plans/05-payment-plan.md) ---
# PAYMENT_PROVIDER=mock
# Lets the demo force a mock failure (decision 4). Keep it off in production.
# PAYMENT_MOCK_CONTROL=false
# Only if the temporary QR demo (C-21) is used. Keep real values in your local .env only.
# BANK_ID=
# ACCOUNT_NO=
