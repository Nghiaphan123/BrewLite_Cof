    {
      "name": "00 API đang chạy",
      "item": [
        {
          "name": "Gọi gốc API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "description": "Nhánh main chưa có /health; gọi gốc /api để kiểm tra API đang chạy.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
