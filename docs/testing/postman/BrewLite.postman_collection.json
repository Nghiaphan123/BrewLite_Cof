                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"Phản hồi dưới 500 ms (NFR-01)\", () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Products (FR-01, FR-02)",
      "item": [
        {
          "name": "Danh sách sản phẩm",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "FR-01. Trả về { items, total }.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const j = pm.response.json();",
                  "pm.test(\"Có items là mảng và total = số phần tử\", () => { pm.expect(j.items).to.be.an(\"array\"); pm.expect(j.total).to.eql(j.items.length); });",
                  "pm.test(\"Giá và tồn kho là số nguyên VND\", () => j.items.forEach(p => { pm.expect(Number.isInteger(p.price)).to.be.true; pm.expect(Number.isInteger(p.stock)).to.be.true; }));",
                  "pm.test(\"Phản hồi dưới 500 ms (NFR-01)\", () => pm.expect(pm.response.responseTime).to.be.below(500));",
                  "const inStock = j.items.find(p => p.stock >= 5) || j.items[0];",
                  "pm.expect(inStock, \"Cần ít nhất một sản phẩm trong seed\").to.exist;",
                  "pm.collectionVariables.set(\"productId\", inStock.id);",
                  "pm.collectionVariables.set(\"productPrice\", inStock.price);"
                ]
              }
            }
          ]
        },
        {
          "name": "Chi tiết sản phẩm",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            },
            "description": "FR-02. Trả về sizes và toppings.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const p = pm.response.json();",
                  "pm.test(\"Có sizes S, M, L\", () => pm.expect(p.sizes).to.include.members([\"S\", \"M\", \"L\"]));",
                  "pm.test(\"Có danh sách toppings\", () => pm.expect(p.toppings).to.be.an(\"array\"));",
                  "const t = (p.toppings || []).find(x => x.stock > 5);",
                  "pm.collectionVariables.set(\"toppingIds\", JSON.stringify(t ? [t.id] : []));",
                  "pm.collectionVariables.set(\"toppingPrice\", t ? t.price : 0);"
                ]
              }
            }
          ]
        },
