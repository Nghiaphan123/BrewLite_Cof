@startuml deployment-production
title Production on Render (Assignment 2, Task 3.2)\nIntended layout. Services are not created yet.
left to right direction
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam nodesep 30
skinparam ranksep 40

node "Customer device" as device {
  artifact "Browser / PWA" as browser
}

node "Developer machine\n<<local>>" as laptop {
  artifact "Docker Compose\nweb :3000, api :3001, db" as compose
  database "Postgres volume\nport may be published" as localdb
}

node "GitHub\n<<CI>>" as github {
  artifact "Repository" as repo
  artifact "Actions\n<<planned>>\nlint, test, build" as actions
  artifact "GHCR\nimage tag = commit SHA" as ghcr
}

cloud "Render\n<<production>>" as render {
  node "Web Service\nbrewlite-web" as websvc {
    artifact "Next.js container\nport 3000\nHTTPS" as web
  }
  node "Web Service\nbrewlite-api" as apisvc {
    artifact "NestJS container\nport 3001\nHTTPS" as api
    artifact "Payment mock\nin-process" as pay
  }
  database "Render PostgreSQL\nbrewlite-db\nprivate" as db {
    artifact "Persistent disk" as disk
  }
}

browser --> web : HTTPS
browser --> api : HTTPS\nAuthorization: Bearer JWT\nCORS
api --> pay : in process\nno third host
api --> db : internal TLS\nDATABASE_URL\nno public port
web ..> api : NEXT_PUBLIC_API_URL\nbaked into the web image

repo --> actions : push / tag
actions --> ghcr : push\nbrewlite-web:<sha>\nbrewlite-api:<sha>
websvc --> ghcr : pull image
apisvc --> ghcr : pull image
actions --> apisvc : deploy SHA\n<<planned>>
actions --> websvc : deploy SHA\n<<planned>>
actions ..> api : smoke\nGET /api/v1/health\n<<planned>>

compose --> localdb : private Compose network

note bottom of db
  Production database is not published.
  Secrets stay in Render, not in git or CI logs.
  Rollback = deploy the previous SHA tag.
end note

note bottom of laptop
  Local Compose is not the production diagram.
  It may publish Postgres to localhost.
end note

note bottom of api
  Health path is GET /api/v1/health.
  The route exists. The public URL does not.
end note

@enduml
