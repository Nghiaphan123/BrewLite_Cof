@startuml change-password-sequence-diagram
title BrewLite – Đổi mật khẩu
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign left
autonumber

actor "Khách hàng" as KH
participant "Web (Next.js)" as UI
participant "API (NestJS)" as API
database "PostgreSQL" as DB

KH -> UI: Ở /profile nhập mật khẩu hiện tại, mật khẩu mới,\nxác nhận; bấm "Đổi mật khẩu"
alt mật khẩu mới ≠ ô xác nhận
  UI --> KH: "Mật khẩu xác nhận không khớp" (không gọi API)
else khớp
  UI -> API: PATCH /auth/password\n{currentPassword, newPassword}
  API -> API: JwtAuthGuard + ChangePasswordDto\n(mật khẩu mới có chữ và số)
  API -> DB: Đọc user theo req.user.id
  DB --> API: user (passwordHash)
  alt mật khẩu hiện tại sai
    API --> UI: 401 CURRENT_PASSWORD_INVALID
  else mật khẩu mới trùng mật khẩu cũ
    API --> UI: 400 PASSWORD_UNCHANGED
  else hợp lệ
    API -> API: bcrypt.hash(newPassword)
    API -> DB: UPDATE users SET passwordHash
    API --> UI: 200 {message}
    UI --> KH: "Đổi mật khẩu thành công."
  end
end
@enduml
