@startuml activity-checkout
title BrewLite - Activity Diagram: From Menu to Paid Order (D-07)

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #444444
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #444444
}
skinparam swimlane {
  BorderColor #888888
  TitleFontStyle bold
}
skinparam note {
  BackgroundColor #FFF8DC
  BorderColor #B59B4B
}

' Red actions are failure, rejection or exception paths.

|Customer|
start
:Open BrewLite;

|Next.js UI|
:Request the menu;

|NestJS API and Database|
:GET /products - read products;

|Next.js UI|
if (Request succeeded?) then (no)
  #FFE0E0:Show error message with retry;
  end
elseif (Any products returned?) then (no)
  #FFE0E0:Show empty-menu message;
  end
else (yes)
  :Show the menu grid;
endif

repeat
  |Customer|
  :Choose a drink;

  |Next.js UI|
  :Request product details;

  |NestJS API and Database|
  :GET /products/:id - read product;

  |Next.js UI|
  :Show detail page with sizes and toppings;

  |Customer|
  :Choose size S, M or L and toppings;

  |Next.js UI|
  :Show updated price for the chosen options;

  |Customer|
  :Add to cart;

  |Next.js UI|
  :Update cart and item count;

  |Customer|
repeat while (Add another drink?) is (yes) not (no)

|Customer|
:Open the cart;

|Next.js UI|
:Show items and total;

|Customer|
:Change quantities or remove items;

|Next.js UI|
:Recalculate total;
if (Cart has items?) then (no)
  #FFE0E0:Show empty cart and link to menu;
  end
else (yes)
endif

|Customer|
:Tap Pay;

|Next.js UI|
if (Signed in with a JWT?) then (no)
  repeat
    |Customer|
    :Enter credentials or register;

    |Next.js UI|
    :Send POST /auth/login or /auth/register;

    |NestJS API and Database|
    :Validate input and credentials (bcrypt)\nIssue JWT if valid;

    |Next.js UI|
    if (Credentials accepted?) then (no)
      #FFE0E0:Show sign-in error, cart kept;
    else (yes)
    endif
  repeat while (Sign-in rejected?) is (yes, try again) not (no)
  |Next.js UI|
  :Store JWT and keep the cart;
else (yes)
endif

|Next.js UI|
:Send POST /orders with JWT, items and optional promotion code;

|NestJS API and Database|
:Verify JWT and validate the request;
if (JWT and request valid?) then (no)
  #FFE0E0:Reject with 401 or 400, no order created;
  |Next.js UI|
  #FFE0E0:Show error or ask to sign in, cart kept;
  end
else (yes)
endif

|NestJS API and Database|
:Load current prices, options and promotion;
:Calculate the authoritative total\nIgnore any client total;
note right
  An invalid or expired promotion code
  is rejected and the customer may
  continue without it.
end note
:Begin transaction;
:Update stock with version check\n(optimistic lock);
if (Enough stock?) then (no)
  #FFE0E0:Roll back, no order created, stock unchanged;
  |Next.js UI|
  #FFE0E0:Show the out-of-stock item, cart kept;
  end
else (yes)
  |NestJS API and Database|
  :Save Order as PENDING with its items\nHold stock;
  :Commit;
endif

|Next.js UI|
:Show checkout with the total;

|Customer|
:Choose Wallet or Card and confirm;

repeat
  |Next.js UI|
  :Generate a new Idempotency-Key;
  :Send POST /payments with JWT, order id, method and key;

  |NestJS API and Database|
  :Verify JWT, validate the request, load the order;
  if (JWT valid, order found, owned by caller and payable?) then (no)
    #FFE0E0:Reject with 401, 403, 404 or 409, no charge;
    |Next.js UI|
    #FFE0E0:Show error message;
    end
  else (yes)
  endif

  |NestJS API and Database|
  :Look up payment by user and Idempotency-Key;
  if (Key already processed?) then (yes)
    :Return the recorded outcome\nNo new charge or effect;
  else (no)
    if (Order is PAYMENT_FAILED?) then (yes)
      :Move order to PENDING (retry);
    else (no)
    endif

    |Payment Service|
    :Process the charge (mock gateway);

    |NestJS API and Database|
    if (Payment succeeded?) then (yes)
      :Record the payment, move order to PAID\nCredit loyalty points once\nCommit;
    else (no)
      #FFE0E0:Record the failed payment\nMove order to PAYMENT_FAILED\nCommit;
    endif
  endif

  |Next.js UI|
  if (Order status is PAID?) then (yes)
    :Clear the cart\nShow confirmation with order id and PAID;
  else (no)
    #FFE0E0:Show payment failure, cart kept;
  endif

  |Customer|
repeat while (PAYMENT_FAILED and customer retries?) is (yes, new key) not (no)

|Customer|
if (Order is PAID?) then (yes)
  :Collect the drink at the counter;
  stop
else (no)
  #FFE0E0:Leave the order unpaid or cancel it\nUnpaid orders expire after 15 minutes;
  end
endif

legend right
  Swimlanes: Customer, Next.js UI, NestJS API and Database, Payment Service (mock).
  Red = failure, rejection or exception path.
  Decision diamonds close at the matching endif or repeat while.
endlegend

@enduml
