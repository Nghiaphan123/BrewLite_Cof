@startuml class-domain
title BrewLite - Domain Class Diagram (D-09)

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam nodesep 40
skinparam ranksep 55
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #444444
  ArrowColor #444444
}
skinparam note {
  BackgroundColor #FFF8DC
  BorderColor #B59B4B
}
hide empty members

' ---------------------------------------------------------------
' Money is stored as whole VND integers (Int). No decimals.
' Identifiers are UUID strings. DateTime is a UTC timestamp.
' Foreign keys are shown as associations, not as attributes.
' ---------------------------------------------------------------

class User {
  +id : UUID
  +email : String {unique}
  -passwordHash : String
  +loyaltyPoints : Int
  +createdAt : DateTime
}

class Product {
  +id : UUID
  +name : String
  +price : Int
  +imageUrl : String
  +stock : Int
  +version : Int
  --
  +holdStock(qty : Int) : Boolean
  +releaseStock(qty : Int) : void
}

class Topping {
  +id : UUID
  +name : String
  +price : Int
  +active : Boolean
}

class Order {
  +id : UUID
  +status : OrderStatus
  +subtotal : Int
  +discountAmount : Int
  +total : Int
  +stockHeld : Boolean
  +expiresAt : DateTime
  +createdAt : DateTime
  +updatedAt : DateTime
  --
  +assertTransition(next : OrderStatus) : void
  +cancel() : void
  +expire() : void
}

class OrderItem {
  +id : UUID
  +size : Size
  +qty : Int
  +unitPrice : Int
  +lineTotal : Int
}

class OrderItemTopping {
  +unitPrice : Int
}

class Payment {
  +id : UUID
  +idempotencyKey : String
  +amount : Int
  +method : PaymentMethod
  +status : PaymentStatus
  +createdAt : DateTime
  +refundedAt : DateTime [0..1]
}

class Promotion {
  +id : UUID
  +code : String {unique}
  +type : PromotionType
  +value : Int
  +minOrderTotal : Int
  +validFrom : DateTime
  +validTo : DateTime
  +active : Boolean
  +usageLimit : Int [0..1]
  +usedCount : Int
  --
  +isApplicable(subtotal : Int, now : DateTime) : Boolean
  +discountFor(subtotal : Int) : Int
}

class LoyaltyTransaction {
  +id : UUID
  +type : LoyaltyTransactionType
  +points : Int
  +createdAt : DateTime
}

enum OrderStatus <<enumeration>> {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum Size <<enumeration>> {
  S
  M
  L
}

enum PaymentMethod <<enumeration>> {
  WALLET
  CARD
}

enum PaymentStatus <<enumeration>> {
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PromotionType <<enumeration>> {
  PERCENT
  FIXED
}

enum LoyaltyTransactionType <<enumeration>> {
  EARN
  REVERSAL
}

' ---------------- Associations ----------------
User "1" -- "0..*" Order : places >
Order "1" *-- "1..*" OrderItem : contains >
OrderItem "0..*" --> "1" Product : orders >
OrderItem "0..*" -- "0..*" Topping : selected
(OrderItem, Topping) .. OrderItemTopping
Order "1" -- "0..*" Payment : paid by >
Order "0..*" --> "0..1" Promotion : applies >
User "1" -- "0..*" LoyaltyTransaction : earns >
Order "1" -- "0..2" LoyaltyTransaction : yields >

' ---------------- Enumeration usage ----------------
Order ..> OrderStatus
OrderItem ..> Size
Payment ..> PaymentMethod
Payment ..> PaymentStatus
Promotion ..> PromotionType
LoyaltyTransaction ..> LoyaltyTransactionType

' ---------------- Notes ----------------
note right of Order
  total = subtotal - discountAmount
  Stock is held when the order is created
  and released once on CANCELLED (stockHeld).
  Only the transitions in the state machine
  are allowed; CANCELLED is reachable from
  PENDING, PAYMENT_FAILED and PAID only.
end note

note bottom of OrderItem
  unitPrice = Product.price + size surcharge
  + topping prices. lineTotal = unitPrice x qty.
  Surcharges: M +5,000, L +10,000, topping +5,000
  (kept in config or seed data, not in the UI).
end note

note bottom of Payment
  One row per payment attempt.
  Unique (user, idempotencyKey) is enforced
  in the database; the user is taken from
  the order and stored on the row.
end note

note bottom of LoyaltyTransaction
  Unique (order, type): at most one EARN and
  one REVERSAL per order. points is negative
  for REVERSAL (cancelled PAID order).
end note

note top of Product
  version is used for optimistic locking
  when stock is updated.
end note

@enduml
