@startuml use-case-checkout
!pragma layout smetana
title UC-01 Đặt và thanh toán đơn hàng (Assignment 2, Task 1.3)
top to bottom direction
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FAF7F2
  BorderColor #6F4E37
  FontColor #3B2A1E
}
skinparam actor {
  BorderColor #3B2A1E
  FontColor #3B2A1E
}
skinparam rectangle {
  BorderColor #6F4E37
}

actor "Khách hàng" as Customer
actor "Payment Service\n(mock)" as Payment

rectangle "BrewLite — UC-01" {
  usecase "Đặt và thanh toán đơn\n(UC-01)" as UC01
  usecase "Đăng nhập\n(UC-AUTH)" as Auth
  usecase "Giỏ hàng hợp lệ\n(UC-CART)" as Cart
  usecase "Tạo đơn PENDING" as Create
  usecase "Thanh toán Ví hoặc Thẻ" as Charge
  usecase "Thanh toán thất bại" as Fail
  usecase "Hết hàng khi thanh toán" as Stock
  usecase "Chưa đăng nhập" as Anonymous
}

Customer --> UC01
Payment --> Charge

UC01 ..> Auth : <<include>>
UC01 ..> Cart : <<include>>
UC01 ..> Create : <<include>>
UC01 ..> Charge : <<include>>
Fail ..> UC01 : <<extend>>
Stock ..> Charge : <<extend>>
Anonymous ..> Auth : <<extend>>

note bottom of UC01
  Quét QR không phải bước của use case này.
  Phương thức bắt buộc: WALLET và CARD, mô phỏng.
end note

@enduml
