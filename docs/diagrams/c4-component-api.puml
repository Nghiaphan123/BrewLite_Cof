@startuml c4-component-api
!include <C4/C4_Component>

title BrewLite - C4 Level 3: API Components (NestJS)

LAYOUT_WITH_LEGEND()

Container(web, "Web App", "Next.js", "Calls the REST API from the browser")
ContainerDb(db, "Database", "PostgreSQL", "Accessed through Prisma")

Container_Boundary(api, "API (NestJS)") {
  Component(pipeline, "Request pipeline", "ValidationPipe, JwtAuthGuard, exception filter, logging interceptor", "Validates DTOs, checks the JWT, formats errors, logs requests")
  Component(auth, "Auth module", "Controller, service, Passport JWT, bcrypt", "Register, login, issue JWT")
  Component(products, "Products module", "Controller, service", "Menu and product details; toppings")
  Component(orders, "Orders module", "Controller, service, state machine, stock service", "Create order, recalculate totals, hold and release stock, assertTransition, order history, cancel")
  Component(payments, "Payments module", "Controller, service, idempotency store", "Pay and retry, replay recorded outcome, move order to PAID or PAYMENT_FAILED")
  Component(provider, "PaymentProvider", "Interface with MockProvider", "Charge request; the mock outcome can be controlled outside production")
  Component(promo, "Promotion and loyalty module", "Service", "Validate and apply promotion codes, credit and reverse points once per order")
  Component(expiry, "Expiry job", "NestJS scheduler", "Cancels unpaid orders after 15 minutes through the normal CANCELLED transition")
  Component(health, "Health module", "Controller", "GET /health with a database check")
  Component(prisma, "Prisma service", "Prisma Client", "Transactions, optimistic-lock updates, migrations and seed")
  Component(config, "Configuration", "ConfigModule", "Validated environment variables")
}

Rel(web, pipeline, "REST, JSON, JWT", "HTTPS")
Rel(pipeline, auth, "Routes to")
Rel(pipeline, products, "Routes to")
Rel(pipeline, orders, "Routes to")
Rel(pipeline, payments, "Routes to")
Rel(pipeline, health, "Routes to")

Rel(orders, products, "Reads prices, holds stock")
Rel(orders, promo, "Applies promotion")
Rel(payments, orders, "Requests state transitions")
Rel(payments, provider, "Charges through")
Rel(payments, promo, "Credits loyalty points")
Rel(expiry, orders, "Cancels expired orders")

Rel(auth, prisma, "Uses")
Rel(products, prisma, "Uses")
Rel(orders, prisma, "Uses")
Rel(payments, prisma, "Uses")
Rel(promo, prisma, "Uses")
Rel(health, prisma, "Checks connection")
Rel(prisma, db, "SQL", "TCP 5432")

@enduml
