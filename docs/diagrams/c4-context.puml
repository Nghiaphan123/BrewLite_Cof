@startuml c4-context
!include <C4/C4_Context>

title BrewLite - C4 Level 1: System Context

LAYOUT_WITH_LEGEND()

Person(customer, "Customer", "Browses the menu, customizes drinks, signs in, pays without cash, and views orders")
Person_Ext(barista, "Barista", "Future extension: accepts orders and updates preparation status. Not built in this delivery.")

System(brewlite, "BrewLite", "Cashless drink-ordering web application: menu, cart, sign-in, orders, simulated payment, order history")

System_Ext(payment, "Payment Service", "Simulated Wallet and Card gateway. No real money moves.")

Rel(customer, brewlite, "Orders and pays using", "HTTPS, web browser")
Rel_D(brewlite, payment, "Sends charge requests to", "Provider interface")
Rel(barista, brewlite, "Will update order status in", "Later extension")

@enduml
