@startuml c4-container
!include <C4/C4_Container>

title BrewLite - C4 Level 2: Containers

LAYOUT_WITH_LEGEND()

Person(customer, "Customer", "Uses a phone or desktop browser")

System_Boundary(brewlite, "BrewLite") {
  Container(web, "Web App", "Next.js, React, TypeScript, TailwindCSS", "Mobile-first PWA. Menu, product detail, cart (Zustand), sign-in, checkout, confirmation, order history. Served on port 3000.")
  Container(api, "API", "NestJS, TypeScript", "REST API on port 3001. Auth, products, orders, payments, promotion and loyalty, health check, scheduled order expiry. Contains the simulated payment provider.")
  ContainerDb(db, "Database", "PostgreSQL", "Users, products, toppings, orders, order items, payments, promotions, loyalty transactions. Accessed through Prisma.")
}

System_Ext(payment, "Payment Service", "Simulated gateway, in-process behind the PaymentProvider interface")

Rel(customer, web, "Opens and uses", "HTTPS")
Rel(web, api, "Calls from the browser", "REST over HTTPS, JSON, JWT")
Rel(api, db, "Reads and writes", "Prisma, TCP 5432, private network")
Rel(api, payment, "Charge requests", "PaymentProvider interface")

@enduml
